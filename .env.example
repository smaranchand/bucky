# AWS Credentials
AWS_ACCESS_KEY_ID=YOUR_AWS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET
AWS_REGION=us-east-1

# Bucky Auth
BUCKY_AUTH_USER=admin
BUCKY_AUTH_PASS=bucky_changeme
BUCKY_API_TOKEN=bucky_secret_token_changeme

# Automatically attempt the write proof-of-concept on every discovered bucket.
# On by default. Set to false to probe read-only and drive writes by hand.
BUCKY_AUTO_WRITE=true
